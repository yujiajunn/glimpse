{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glimpse",
  "version": "0.1.0",
  "identifier": "com.local.glimpse",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "preview",
        "title": "Glimpse Preview",
        "width": 800,
        "height": 600,
        "minWidth": 200,
        "minHeight": 150,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "visible": false,
        "shadow": true,
        "center": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://your-update-server.example.com/glimpse/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "REPLACE_WITH_YOUR_PUBLIC_KEY",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}